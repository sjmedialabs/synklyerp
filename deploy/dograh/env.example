# Dograh environment — copy to /opt/dograh/.env
# Generate secrets: openssl rand -hex 32

ENVIRONMENT=local
ENABLE_TELEMETRY=false

PUBLIC_HOST=ai.synklyapp.com
PUBLIC_BASE_URL=https://ai.synklyapp.com
BACKEND_API_ENDPOINT=https://ai.synklyapp.com
MINIO_PUBLIC_ENDPOINT=https://ai.synklyapp.com

# Required — start_docker.sh generates OSS_JWT_SECRET if missing
# OSS_JWT_SECRET=

# Optional provider keys (configure in Dograh UI too)
# OPENAI_API_KEY=
# DEEPGRAM_API_KEY=
# ELEVENLABS_API_KEY=
